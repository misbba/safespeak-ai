# ============================================================
# SafeSpeak AI - Environment Configuration Template
# ============================================================

# Flask Backend Host & Port
HOST=127.0.0.1
PORT=5000
SECRET_KEY=safespeak-ai-production-secret-key-replace-in-production

# AI Engine Configuration (Optional)
# If left blank, SafeSpeak AI automatically operates in resilient Demo / Heuristic Mode
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gemini-2.5-flash

# Maximum Upload File Size in Bytes (Default: 10MB)
MAX_CONTENT_LENGTH=10485760
