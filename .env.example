# ============================================================
# SafeSpeak AI — Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# BACKEND SETTINGS (Render Web Service)
# ------------------------------------------------------------
# Secret key used for session security and crypto
SECRET_KEY=replace-with-a-secure-random-secret-key

# Production Frontend URL for CORS (e.g., https://safespeak-ai.onrender.com)
# Comma-separated if multiple domains are needed
FRONTEND_URL=https://safespeak-ai.onrender.com

# AI Engine Configuration (Optional: Gemini / OpenAI)
# Leave blank to use SafeSpeak's built-in offline Cyber Risk Engine
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gemini-2.5-flash

# Maximum Upload File Size in Bytes (Default: 10MB)
MAX_CONTENT_LENGTH=10485760

# ------------------------------------------------------------
# FRONTEND SETTINGS (Render Static Site Build)
# ------------------------------------------------------------
# Base URL for Backend API (e.g. https://safespeak-backend.onrender.com)
# Leave empty for local dev with Vite proxy (/api)
VITE_API_BASE_URL=https://safespeak-backend.onrender.com
